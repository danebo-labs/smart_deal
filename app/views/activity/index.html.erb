<% content_for :head do %>
  <script src="/vendor/chart.umd.min.js" defer data-turbo-track="reload"></script>
<% end %>

<div class="min-h-screen bg-gray-100 pt-20 md:pt-24 pb-8">
  <div class="max-w-7xl mx-auto px-4">

    <!-- HEADER -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900">Actividad</h1>
      <p class="text-gray-600 text-sm">Consultas realizadas al asistente, por día y por usuario</p>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">

      <%= render partial: "dashboard/metric_card", locals: {
        title: "Consultas hoy",
        value: @chart_data[:today],
        color: "text-green-600"
      } %>

      <%= render partial: "dashboard/metric_card", locals: {
        title: "Consultas últimos 30 días",
        value: @chart_data[:total],
        color: "text-blue-600"
      } %>

      <%= render partial: "dashboard/metric_card", locals: {
        title: "Documentos en biblioteca",
        value: @kb_documents.size,
        color: "text-gray-800"
      } %>

    </div>

    <!-- CHART -->
    <div class="bg-white p-6 rounded-xl shadow mb-8">
      <h3 class="text-lg font-semibold text-gray-800 mb-1">Consultas por día</h3>
      <p class="text-sm text-gray-500 mb-4">Últimos 30 días · por usuario</p>
      <% if @chart_data[:datasets].any? %>
        <%= tag.canvas(
          data: {
            controller: "usage-chart",
            usage_chart_config_value: @chart_data
          },
          height: 120
        ) %>
      <% else %>
        <p class="text-sm text-gray-400 py-8 text-center">Sin consultas registradas en los últimos 30 días.</p>
      <% end %>
    </div>

    <!-- PER-USER TABLE -->
    <% if @chart_data[:per_user].any? %>
      <div class="bg-white p-6 rounded-xl shadow mb-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Consultas por usuario</h3>

        <div class="overflow-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Correo</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Consultas (30 días)</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Consultas hoy</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Última actividad</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @chart_data[:per_user].each do |row| %>
                <tr>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= row[:email] %></td>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= row[:window_queries] %></td>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= row[:today_queries] %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                    <%= row[:last_activity]&.strftime("%Y-%m-%d %H:%M") || "—" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <!-- KB DOCUMENTS -->
    <%= render "shared/kb_documents_table", kb_documents: @kb_documents %>

    <!-- CHAT QUERY LATENCY -->
    <% if @performance_metrics[:total_queries].positive? %>
      <div class="bg-white p-6 rounded-xl shadow mb-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Rendimiento consultas chat (hoy)</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 bg-gray-50 rounded-lg">
            <div class="text-sm text-gray-500">Latencia promedio</div>
            <div class="text-2xl font-bold text-gray-900">
              <%= @performance_metrics[:avg_latency] %>ms
            </div>
          </div>

          <div class="p-4 bg-gray-50 rounded-lg">
            <div class="text-sm text-gray-500">Consulta más rápida</div>
            <div class="text-2xl font-bold text-green-600">
              <%= @performance_metrics[:fastest_query] %>ms
            </div>
          </div>

          <div class="p-4 bg-gray-50 rounded-lg">
            <div class="text-sm text-gray-500">Consulta más lenta</div>
            <div class="text-2xl font-bold text-red-600">
              <%= @performance_metrics[:slowest_query] %>ms
            </div>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>
