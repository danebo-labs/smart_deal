<%# locals: finding, highlighted: false %>
<%# `highlighted` is true for one render only: the finding a dictation
    confirmation just created (Salesforce Voice-to-Form pattern, plan section
    2.3) — visibly marked, with its undo inline. On reload it is a plain finding. %>
<li id="<%= dom_id(finding) %>"
    <% if highlighted %>data-highlighted-finding="true"<% end %>
    class="flex min-h-[60px] scroll-mt-24 flex-col gap-3 rounded-xl border bg-white p-4 sm:flex-row sm:items-start <%= highlighted ? "border-[hsl(217,91%,50%)] ring-2 ring-[hsl(217,91%,50%)] bg-[hsl(217,91%,97%)]" : "border-[hsl(215,20%,88%)]" %>">
  <% if finding.field_photo %>
    <%= link_to field_photo_path(finding.field_photo), target: "_blank", rel: "noopener",
        class: "block h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-[hsl(215,20%,93%)]", "aria-label": t("certifier.finding.view_photo") do %>
      <% if finding.field_photo.thumbnail_data_url %>
        <%= image_tag finding.field_photo.thumbnail_data_url, class: "h-full w-full object-cover", alt: "" %>
      <% end %>
    <% end %>
  <% end %>

  <div class="min-w-0 flex-1">
    <% if highlighted && finding.voice_dictation_id %>
      <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-[hsl(217,91%,35%)]"><%= t("certifier.dictation.finding.from_dictation") %></p>
    <% end %>
    <p class="text-base text-[hsl(222,47%,10%)]"><%= finding.body %></p>
    <% if finding.location.present? %>
      <p class="mt-1 text-sm text-[hsl(215,20%,42%)]"><%= finding.location %></p>
    <% end %>

    <%# What the certifier classified, and what is still pending. An unassigned
        equipment or a missing severity is shown as such: the absence of a
        classification never reads as "sin defectos" (fixed rule 1). %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <span class="rounded-md bg-[hsl(215,20%,93%)] px-2 py-1 text-xs font-medium text-[hsl(215,20%,32%)]">
        <%= certifier_finding_equipment_label(finding) %>
      </span>
      <% if finding.centrave_item_key %>
        <span class="rounded-md bg-[hsl(215,20%,93%)] px-2 py-1 text-xs font-medium text-[hsl(215,20%,32%)]">
          <%= t("certifier.centrave.#{finding.centrave_item_key}") %>
        </span>
      <% end %>
      <% if finding.severity.present? %>
        <span class="rounded-md px-2 py-1 text-xs font-semibold <%= finding.severity == "grave" ? "bg-red-100 text-red-700" : "bg-[hsl(48,96%,89%)] text-[hsl(32,81%,29%)]" %>">
          <%= t("certifier.severities.#{finding.severity}") %>
        </span>
      <% else %>
        <span class="rounded-md border border-dashed border-[hsl(215,20%,80%)] px-2 py-1 text-xs text-[hsl(215,20%,45%)]">
          <%= t("certifier.finding.unclassified_severity") %>
        </span>
      <% end %>
      <% if finding.nch2840_box.present? %>
        <span class="text-xs text-[hsl(215,20%,45%)]"><%= t("certifier.finding.nch2840_box") %> <%= finding.nch2840_box %></span>
      <% end %>
      <% if finding.norm_point.present? %>
        <span class="text-xs text-[hsl(215,20%,45%)]"><%= t("certifier.finding.norm_point") %> <%= finding.norm_point %></span>
      <% end %>
    </div>
  </div>

  <%# 16px minimum spacing between adjacent controls (section 2.3). %>
  <div class="flex shrink-0 gap-4">
    <% if highlighted && finding.voice_dictation_id %>
      <%# Undo puts the text back in the editable panel — one tap, no
          re-recording. It reverses only the confirmation, so no confirm dialog. %>
      <%= button_to t("certifier.dictation.finding.undo"), undo_voice_dictation_path(finding.voice_dictation_id), method: :post,
          form_class: "inline-block",
          class: "flex min-h-[60px] min-w-[60px] cursor-pointer items-center justify-center rounded-lg bg-[hsl(217,91%,50%)] px-4 text-sm font-semibold text-white transition-colors hover:bg-[hsl(217,91%,45%)]" %>
    <% end %>
    <%= link_to t("certifier.finding.edit"), edit_inspection_finding_path(finding),
        class: "flex min-h-[60px] min-w-[60px] items-center justify-center rounded-lg border border-[hsl(215,20%,88%)] px-3 text-sm font-medium text-[hsl(222,47%,10%)] transition-colors hover:bg-[hsl(215,20%,93%)]" %>
    <%= button_to t("certifier.finding.delete"), inspection_finding_path(finding), method: :delete,
        form_class: "inline-block",
        data: { turbo_confirm: t("certifier.finding.delete_confirm") },
        class: "flex min-h-[60px] min-w-[60px] items-center justify-center rounded-lg border border-red-200 px-3 text-sm font-medium text-red-600 transition-colors hover:bg-red-50" %>
  </div>
</li>
