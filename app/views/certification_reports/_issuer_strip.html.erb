<%# locals: account, report %>
<%# The company's issuer identity, identical on every report of the account
    (fixed rule 14). This is the web editor's strip, not the document header:
    1B builds that one from an explicit data set. With no logo it degrades to a
    typographic block — never to the Danebo brand, which is the tool and not the
    issuer of the report (shared contract point 6). %>
<section class="mb-4 flex items-center gap-3 rounded-xl border border-[hsl(215,20%,88%)] bg-white p-3">
  <% if account.certifier_logo? %>
    <%= image_tag logo_certifier_settings_path, alt: account.certifier_name.to_s,
        class: "h-10 w-auto max-w-[96px] shrink-0 object-contain" %>
  <% end %>
  <div class="min-w-0 flex-1">
    <% if account.certifier_identified? %>
      <p class="truncate text-sm font-semibold text-[hsl(222,47%,10%)]"><%= account.certifier_name %></p>
      <p class="truncate text-xs text-[hsl(215,20%,42%)]"><%= t("certifier.settings.minvu_role_line", role: account.certifier_minvu_role) %></p>
    <% else %>
      <p class="text-sm text-[hsl(215,20%,42%)]"><%= t("certifier.settings.incomplete_short") %></p>
    <% end %>
    <p class="mt-0.5 truncate text-xs text-[hsl(215,20%,55%)]">
      <% if report.internal_number.present? %>
        <%= t("certifier.fields.internal_number") %>: <%= report.internal_number %>
      <% else %>
        <%= t("certifier.show.danebo_reference", reference: report.danebo_reference) %>
      <% end %>
    </p>
  </div>
  <%= link_to t("certifier.settings.link"), certifier_settings_path,
      class: "flex min-h-[60px] shrink-0 items-center justify-center rounded-lg border border-[hsl(215,20%,88%)] px-3 text-sm font-medium text-[hsl(222,47%,10%)] transition-colors hover:bg-[hsl(215,20%,93%)]" %>
</section>
