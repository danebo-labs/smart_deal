<% content_for :title, t("certifier.edit_report.title") %>

<main class="mx-auto max-w-2xl px-4 pt-20 pb-16 md:pt-28">
  <h1 class="mb-6 text-xl font-semibold text-[hsl(222,47%,10%)] sm:text-2xl"><%= t("certifier.edit_report.title") %></h1>

  <%= render "certification_reports/errors", record: @report %>

  <%= form_with model: @report, url: certification_report_path(@report), class: "mt-4 space-y-5" do |f| %>
    <div class="space-y-1.5">
      <%= f.label :building_name, t("certifier.fields.building_name"), class: "block text-sm font-medium text-[hsl(222,47%,10%)]" %>
      <%= f.text_field :building_name,
          class: "min-h-[60px] w-full rounded-lg border border-[hsl(215,20%,88%)] bg-white px-4 text-base text-[hsl(222,47%,10%)] focus:border-[hsl(217,91%,50%)] focus:outline-none focus:ring-2 focus:ring-[hsl(217,91%,50%)]/30" %>
    </div>

    <%= render "certification_reports/building_fields", f: f %>

    <%= f.submit t("certifier.edit_report.submit"),
        class: "flex min-h-[72px] w-full cursor-pointer items-center justify-center rounded-xl bg-[hsl(217,91%,50%)] text-base font-semibold text-white transition-colors hover:bg-[hsl(217,91%,45%)]" %>
  <% end %>

  <%= link_to t("certifier.edit_report.back"), certification_report_path(@report),
      class: "mt-4 flex min-h-[60px] w-full items-center justify-center rounded-lg border border-[hsl(215,20%,88%)] text-base font-medium text-[hsl(215,20%,42%)] transition-colors hover:bg-[hsl(215,20%,93%)]" %>
</main>
