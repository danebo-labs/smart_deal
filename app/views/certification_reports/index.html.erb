<% content_for :title, t("certifier.my_reports.title") %>

<main class="mx-auto max-w-2xl px-4 pt-20 pb-16 md:pt-28">
  <h1 class="mb-6 text-xl font-semibold text-[hsl(222,47%,10%)] sm:text-2xl"><%= t("certifier.my_reports.title") %></h1>

  <%# Primary action — 72px min tap target (section 2.3). %>
  <%= link_to new_certification_report_path,
      class: "mb-6 flex min-h-[72px] w-full items-center justify-center gap-2 rounded-xl bg-[hsl(217,91%,50%)] px-6 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[hsl(217,91%,45%)]" do %>
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    <%= t("certifier.my_reports.new_report") %>
  <% end %>

  <% if @reports.empty? %>
    <p class="text-base text-[hsl(215,20%,42%)]"><%= t("certifier.my_reports.empty") %></p>
  <% else %>
    <%# 16px minimum spacing between adjacent controls (section 2.3). %>
    <ul class="space-y-4">
      <% @reports.each do |report| %>
        <li>
          <%= link_to certification_report_path(report),
              class: "flex min-h-[60px] w-full flex-col justify-center gap-1.5 rounded-xl border border-[hsl(215,20%,88%)] bg-white px-4 py-3 transition-colors hover:border-[hsl(217,91%,50%)]" do %>
            <div class="flex items-center justify-between gap-3">
              <span class="truncate text-base font-medium text-[hsl(222,47%,10%)]"><%= report.building_name %></span>
              <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= certifier_status_badge_class(report.status) %>">
                <%= t("certifier.statuses.#{report.status}") %>
              </span>
            </div>
            <div class="flex items-center justify-between text-sm text-[hsl(215,20%,42%)]">
              <span><%= t("certifier.my_reports.findings_count", count: report.inspection_findings.size) %></span>
              <span><%= l(report.updated_at, format: :short) %></span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
