<%#
  Shared KB documents card. Renders identically (rows + checkbox + thumbnail) on
  desktop and mobile. variant only changes the outer wrapper:
    :mobile  → in-chat scrollable flex panel (md:hidden)
    :desktop → rounded card with header (hidden lg:flex sidebar slot)
%>
<% items_id    = "kb-docs-#{variant}-items" %>
<% sentinel_id = "kb-docs-#{variant}-sentinel" %>
<% search_id   = "kb-docs-#{variant}-search" %>
<% q           = local_assigns[:q] %>

<% if variant == :desktop %>
  <div class="flex-1 rounded-2xl border border-[hsl(215,20%,88%)] bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center gap-3">
      <%= image_tag account_branding.logo_path,
          class: account_branding.branded? ? "h-9 w-auto max-w-[8rem] shrink-0 object-contain" : "h-9 w-9 shrink-0 object-contain",
          alt: account_branding.logo_alt %>
      <div class="flex min-w-0 flex-col gap-0.5">
        <% if account_branding.show_danebo_wordmark? %>
          <div class="flex items-baseline gap-0 leading-none">
            <span class="brand-wordmark text-[15px] font-semibold text-[hsl(222,47%,10%)]">danebo</span>
            <span class="brand-suffix text-[15px] font-light text-[hsl(222,47%,10%)] opacity-[0.72]">.ai</span>
          </div>
        <% end %>
        <h3 class="text-xs font-medium text-[hsl(215,20%,52%)]">Archivos Disponibles</h3>
      </div>
    </div>
    <div class="overflow-y-auto max-h-[calc(100vh-300px)] pr-1">
<% end %>

<div data-controller="docs-search"
     data-docs-search-url-value="/home/documents"
     class="<%= variant == :mobile ? 'px-3 pt-3' : 'mb-3' %>">
  <div class="relative">
    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[hsl(215,20%,55%)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input type="search"
           id="<%= search_id %>"
           name="q"
           value="<%= q %>"
           data-docs-search-target="input"
           data-action="input->docs-search#search"
           autocomplete="off"
           placeholder="Buscar manual…"
           aria-label="Buscar manual"
           class="w-full h-11 rounded-xl border border-[hsl(215,20%,88%)] bg-[hsl(215,20%,97%)] pl-9 pr-3 text-sm text-[hsl(222,47%,10%)] placeholder:text-[hsl(215,20%,55%)] focus:outline-none focus:ring-2 focus:ring-[hsl(217,91%,50%,0.4)] focus:border-[hsl(217,91%,50%)]">
  </div>
</div>

<div id="<%= items_id %>" class="<%= variant == :mobile ? 'space-y-1.5 p-3' : 'space-y-1.5' %>">
  <% if kb_documents.any? %>
    <%= render partial: "home/kb_docs_card_rows", locals: { kb_documents: kb_documents, pinned_uris: pinned_uris, image_url_service: image_url_service } %>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-3 py-8">
      <svg class="h-10 w-10 text-[hsl(215,20%,75%)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <p class="text-sm text-[hsl(215,20%,55%)]">Sin documentos en la base de conocimiento</p>
    </div>
  <% end %>
</div>

<% if has_more %>
  <%= render partial: "home/kb_docs_card_sentinel",
             locals: { sentinel_id: sentinel_id, page: next_page, q: q } %>
<% end %>

<% if variant == :desktop %>
    </div>
  </div>
<% end %>
