# Kamal deployment template — copy to config/deploy.yml and customize.
#
#   cp config/deploy.yml.example config/deploy.yml
#
# config/deploy.yml is gitignored. Never commit real hosts, registry passwords,
# or production-only identifiers if the repo is public.
#
# Secrets Kamal injects (RAILS_MASTER_KEY, DB_PASSWORD, ANTHROPIC_API_KEY,
# APPSIGNAL_PUSH_API_KEY, KAMAL_REGISTRY_PASSWORD) live in .kamal/secrets
# (also gitignored). See README “Secrets and Kamal”.

service: smart-deal
image: YOUR_DOCKERHUB_USER/smart-deal

servers:
  web:
    hosts:
      - YOUR_EC2_PUBLIC_IP
    options:
      memory: 1500m
      cpus: 1.5

  worker:
    hosts:
      - YOUR_EC2_PUBLIC_IP
    cmd: bundle exec rake solid_queue:start
    options:
      memory: 1g
      cpus: 1.0

proxy:
  ssl: true
  # El peor caso de una consulta RAG es el cold-start de Aurora Serverless:
  # AuroraColdStartRetry duerme 15+30+45s (RETRY_DELAYS) más la duración de las
  # cuatro llamadas a Bedrock. El default de kamal-proxy (30s) mata la conexión
  # mientras Rails sigue trabajando, y el técnico ve un 502 de una request que
  # termina 200 OK. 120s cubre la cascada completa con margen.
  response_timeout: 120
  hosts:
    # Temporary: apex/www serve the app until the marketing landing is ready.
    - danebo.ai
    - www.danebo.ai
    - elevator.danebo.ai
    - ascensoresclimb.danebo.ai
  app_port: 80

registry:
  server: docker.io
  username: YOUR_DOCKERHUB_USER
  password:
    - KAMAL_REGISTRY_PASSWORD

builder:
  arch: amd64

env:
  clear:
    RAILS_ENV: production
    RAILS_LOG_TO_STDOUT: "true"
    RAILS_SERVE_STATIC_FILES: "true"
    RAILS_MAX_THREADS: "5"
    AWS_REGION: us-east-1
    DB_HOST: your-app.rds.amazonaws.com
    DB_USERNAME: app_user
    DB_NAME: smart_deal_production
    DB_CACHE_NAME: smart_deal_production_cache
    DB_QUEUE_NAME: smart_deal_production_queue
    DB_CABLE_NAME: smart_deal_production_cable
    BEDROCK_KNOWLEDGE_BASE_ID: your-kb-id
    BEDROCK_BULK_DATA_SOURCE_ID: your-bulk-no-chunking-data-source-id
    BEDROCK_EMBEDDING_MODEL_ID: amazon.titan-embed-text-v2:0
    BEDROCK_MODEL_ID: global.anthropic.claude-haiku-4-5-20251001-v1:0
    KNOWLEDGE_BASE_S3_BUCKET: your-kb-source-bucket
    INGESTION_REENQUEUE: "true"
    AWS_HTTP_READ_TIMEOUT: "90"
    QUERY_ROUTING_ENABLED: "false"
    SHARED_SESSION_ENABLED: "false"
    SHOW_RAG_SOURCES: "false"
    RAG_EVIDENCE_SELECTOR_ENABLED: "false"
    RAG_EVIDENCE_EXPANSION_ENABLED: "false"
    RAG_EVIDENCE_CARDS_ENABLED: "false"
    RAG_STRUCTURED_EVIDENCE_ROUTE_ENABLED: "false"
    # Citation attribution contract (Rag::CitationMarkerNormalizer +
    # Rag::CitationAttributionGuard) and partial abstention contract. Only the
    # exact string "true" enables them; anything else is the dd0a421 behavior.
    # Turn both on together for the pilot gate — see
    # docs/RAG_CITATION_ATTRIBUTION_CONTRACT_2026-07-30.md.
    RAG_CITATION_ATTRIBUTION_CONTRACT_ENABLED: "false"
    RAG_PARTIAL_ABSTENTION_CONTRACT_ENABLED: "false"
    # Emits one [PILOT_AUDIT] line per interaction with the full question,
    # answer and citations, plus one line per retrieved chunk. Required for the
    # pilot dossier (docs/METRICS.md); without it only the 300-char
    # [RAG_QUALITY] question survives and `bin/pilot_metrics --with-questions`
    # has nothing to surface. Places raw technician text in production logs, so
    # enable it only under the corresponding privacy authorization.
    PILOT_AUDIT_CAPTURE: "false"
  secret:
    - RAILS_MASTER_KEY
    - DB_PASSWORD
    - ANTHROPIC_API_KEY
    - APPSIGNAL_PUSH_API_KEY

aliases:
  console: app exec --interactive --reuse "bin/rails console"
  shell:   app exec --interactive --reuse "bash"
  logs:    app logs -f
  dbc:     app exec --interactive --reuse "bin/rails dbconsole -p"

ssh:
  user: ubuntu
  keys: ["~/.ssh/your-deploy-key.pem"]
